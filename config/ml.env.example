# Immich Machine Learning Configuration
# Optimized for CPU-only inference on i7-7700HQ (8 threads)

# ===== MODEL SELECTION =====
# SigLIP: Better zero-shot classification, faster than CLIP ViT-B-32
MACHINE_LEARNING_PRELOAD__CLIP=ViT-B-16-SigLIP__webli

# Alternative models (uncomment to test):
# MACHINE_LEARNING_PRELOAD__CLIP=ViT-B-32__openai
# MACHINE_LEARNING_PRELOAD__CLIP=ViT-L-14__openai

# ===== RESOURCE LIMITS =====
# 6GB RAM limit prevents OOM on 16GB system
# CPU-only: no GPU memory contention
MACHINE_LEARNING_MODEL_TTL=0  # Keep models loaded (faster inference)

# ===== PERFORMANCE TUNING =====
# ONNX Runtime settings for CPU
OMP_NUM_THREADS=4
ONNXRUNTIME_EXECUTION_PROVIDER=CPUExecutionProvider

# ===== FEATURE FLAGS =====
# Disable unused models to save RAM
MACHINE_LEARNING_ENABLE__FACIAL_RECOGNITION=true
MACHINE_LEARNING_ENABLE__OBJECT_DETECTION=false
MACHINE_LEARNING_ENABLE__BACKGROUND_REMOVAL=false
